# URL base da API Spring Boot, sem barra no final e sem o sufixo /api.
# É embutida no bundle durante o build (npm run build): mudar exige novo build.
# Se ficar vazia, o front chama /api na mesma origem (no dev, o proxy do Vite
# repassa para http://localhost:8080).
# Produção: VITE_API_URL=https://api-pokedex.matheusms.io
VITE_API_URL=http://localhost:8080
